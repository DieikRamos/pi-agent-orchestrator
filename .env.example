# Project whose .pi/agents.yml defines the worker roster and whose files the
# agents will edit. Use an absolute path when the compose file is not in that
# project.
PI_PROJECT_DIR=.

# Host loopback port exposed by docker compose.
PI_BROKER_PORT=8787

# Host Pi agent directory (auth.json, models.json, settings.json).
# Defaults to ${HOME}/.pi/agent.
# PI_AGENT_DIR=/Users/you/.pi/agent

# Optional: tell host Pi sessions not to autostart a local broker.
# Set this in the shell where you run `pi`, not only in this .env.
# PI_ORCHESTRATOR_NO_AUTOSTART=1
